           SLIDE 17: CASO PRÁTICO (Viagem a SP)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="17" data-title="Caso Prático">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">CASO PRÁTICO</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">“Planeje uma viagem para São Paulo”</h2>
          <p class="text-[#5D5D66] text-xl mt-2">Um único pedido pode virar várias tarefas especializadas.</p>
        </div>

        <!-- Diagram -->
        <div class="my-auto flex flex-col items-center w-full max-w-5xl mx-auto">
          <div class="bg-[#350EFF] text-white px-10 py-4 rounded-2xl font-bold text-xl text-center w-84 shadow-sm">
            ORQUESTRADOR
          </div>

          <!-- Architectural SVG Branching Tree Connector -->
          <div class="w-full h-16 my-1">
            <svg class="w-full h-full" viewBox="0 0 1024 64" fill="none">
              <!-- Central trunk -->
              <path d="M 512,0 L 512,28" stroke="#350EFF" stroke-width="2" stroke-linecap="round" />
              
              <!-- Left branch to Voo -->
              <path d="M 512,28 L 160,28 L 160,52" stroke="#350EFF" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              <polygon points="154,50 160,60 166,50" fill="#350EFF" />
              
              <!-- Center branch to Hotel -->
              <path d="M 512,28 L 512,52" stroke="#350EFF" stroke-width="2" stroke-linecap="round" />
              <polygon points="506,50 512,60 518,50" fill="#350EFF" />
              
              <!-- Right branch to Transporte -->
              <path d="M 512,28 L 864,28 L 864,52" stroke="#350EFF" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              <polygon points="858,50 864,60 870,50" fill="#350EFF" />
            </svg>
          </div>

          <div class="grid grid-cols-3 gap-8 w-full">
            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <h4 class="text-2xl font-bold text-[#272727]">VOO</h4>
              <p class="text-[#5D5D66] text-base mt-2">Buscar opções e horários</p>
            </div>

            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <h4 class="text-2xl font-bold text-[#272727]">HOTEL</h4>
              <p class="text-[#5D5D66] text-base mt-2">Comparar preços e local</p>
            </div>

            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <h4 class="text-2xl font-bold text-[#272727]">TRANSPORTE</h4>
              <p class="text-[#5D5D66] text-base mt-2">Estimar deslocamentos</p>
            </div>
          </div>
        </div>

        <!-- Faixa Lavender -->
        <div class="bg-[#EEEDF8] rounded-2xl px-8 py-5 flex items-center justify-between text-[#272727]">
          <span class="text-base text-[#272727]">O orquestrador não precisa saber como cada especialista calcula seu resultado interno.</span>
          <span class="font-semibold text-sm text-[#5D5D66]">17</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 18: NÃO É MÁGICA (Desafios)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="18" data-title="Desafios">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">NÃO É MÁGICA</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">A2A resolve interoperabilidade — não resolve todos os problemas</h2>
        </div>

        <!-- 5 Cards Grid -->
        <div class="grid grid-cols-3 gap-6 my-auto">
          <div class="bg-white p-6 rounded-[24px] border border-[#E6E6EC]">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-1">SEGURANÇA</div>
            <div class="text-xl font-bold text-[#272727]">Quem pode delegar o quê?</div>
          </div>

          <div class="bg-white p-6 rounded-[24px] border border-[#E6E6EC]">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-1">CONFIANÇA</div>
            <div class="text-xl font-bold text-[#272727]">Como validar o resultado?</div>
          </div>

          <div class="bg-white p-6 rounded-[24px] border border-[#E6E6EC]">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-1">CUSTO</div>
            <div class="text-xl font-bold text-[#272727]">Mais agentes = mais chamadas</div>
          </div>

          <div class="bg-white p-6 rounded-[24px] border border-[#E6E6EC]">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-1">LATÊNCIA</div>
            <div class="text-xl font-bold text-[#272727]">Mais etapas podem atrasar</div>
          </div>

          <div class="bg-white p-6 rounded-[24px] border border-[#E6E6EC] col-span-2">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-1">OBSERVABILIDADE</div>
            <div class="text-xl font-bold text-[#272727]">Como rastrear a cadeia de execução completa?</div>
          </div>
        </div>

        <!-- Takeaway Card Ativo -->
        <div class="bg-[#350EFF] text-white rounded-2xl px-8 py-5 flex items-center justify-between">
          <span class="text-lg font-bold">A pergunta de arquitetura deixa de ser “qual agente?” e passa a ser “qual colaboração vale a pena?”</span>
          <span class="font-semibold text-sm text-[#EEEDF8]">18</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 19: ATIVIDADE PRÁTICA
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="19" data-title="Atividade Prática">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">ATIVIDADE</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Desenhe seu primeiro sistema multi-agente</h2>
          <p class="text-[#5D5D66] text-xl mt-2"><strong>Cenário:</strong> Um sistema de atendimento para uma empresa de tecnologia.</p>
        </div>

        <!-- 2 Columns: Questions & Challenge -->
        <div class="grid grid-cols-12 gap-8 my-auto items-stretch">
          <!-- 5 Questions List -->
          <div class="col-span-8 bg-white p-8 rounded-[24px] border border-[#E6E6EC] divide-y divide-[#E6E6EC]">
            <div class="flex items-center gap-6 py-3">
              <span class="text-lg font-extrabold text-[#350EFF] w-8">01</span>
              <span class="text-lg font-bold text-[#272727]">Quais agentes existem?</span>
            </div>
            <div class="flex items-center gap-6 py-3">
              <span class="text-lg font-extrabold text-[#350EFF] w-8">02</span>
              <span class="text-lg font-bold text-[#272727]">Qual agente orquestra?</span>
            </div>
            <div class="flex items-center gap-6 py-3">
              <span class="text-lg font-extrabold text-[#350EFF] w-8">03</span>
              <span class="text-lg font-bold text-[#272727]">Quando cada agente recebe uma Task?</span>
            </div>
            <div class="flex items-center gap-6 py-3">
              <span class="text-lg font-extrabold text-[#350EFF] w-8">04</span>
              <span class="text-lg font-bold text-[#272727]">O que é Message? O que é Artifact?</span>
            </div>
            <div class="flex items-center gap-6 py-3">
              <span class="text-lg font-extrabold text-[#350EFF] w-8">05</span>
              <span class="text-lg font-bold text-[#272727]">Que informação aparece no Agent Card?</span>
            </div>
          </div>

          <!-- Challenge Box (Deep Black #0A0A14) -->
          <div class="col-span-4 bg-[#0A0A14] text-white p-8 rounded-[24px] flex flex-col justify-between">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-4">DESAFIO</div>
              <h3 class="text-4xl font-extrabold text-white leading-tight mb-4">
                Justifique por que cada agente existe.
              </h3>
              <p class="text-[#5D5D66] text-base">
                Evite criar agentes sem responsabilidade clara ou ganho real de desacoplamento.
              </p>
            </div>
            <div class="text-xs font-semibold text-[#5D5D66]">Tempo estimado: 15 min</div>
          </div>
        </div>

        <div class="flex justify-between items-center text-sm text-[#5D5D66]">
          <span>Exercício Prático em Grupo</span>
          <span class="font-semibold">19</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 20: SLIDE DE IMPACTO / FECHAMENTO
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#350EFF] text-white relative overflow-hidden" data-slide="20" data-title="Conclusão">
        <!-- Header -->
        <div>
          <div class="text-base font-semibold uppercase tracking-[0.2em] text-[#EEEDF8]">A IDEIA CENTRAL</div>
        </div>

        <!-- Big Impact Phrase -->
        <div class="my-auto max-w-5xl">
          <h2 class="text-[88px] font-black tracking-tight text-white leading-[1.02] mb-8">
            Agentes não precisam <br>
            <span class="text-[#FFE57F]">fazer tudo sozinhos.</span>
          </h2>
          <p class="text-3xl text-[#EEEDF8] font-normal leading-relaxed mb-12 max-w-3xl">
            Com A2A, eles podem descobrir capacidades, delegar trabalho e trocar resultados.
          </p>

          <!-- Pipeline sutil inferior -->
          <div class="inline-flex items-center gap-5 text-xl font-bold">
            <span class="px-5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white">AGENTE</span>
            <span class="text-white">→</span>
            <span class="px-5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white">AGENTE</span>
            <span class="text-white">→</span>
            <span class="px-5 py-2.5 rounded-xl bg-[#FFE57F] text-[#272727]">RESULTADO</span>
          </div>
        </div>

        <!-- Footer -->
        <div class="flex justify-between items-center text-[#EEEDF8]/80 text-sm pt-8 border-t border-white/20">
          <span>Fonte técnica: A2A Protocol v1.0.0</span>
          <span class="font-semibold text-white">20</span>
        </div>
      </section>

    </div>
  </main>

  <!-- ==========================================
       FLOATING CONTROLS & PRESENTATION UI
       ========================================== -->
  <nav id="controls-bar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 px-4 py-2 rounded-full bg-[#0A0A14]/90 text-white backdrop-blur-md border border-[#272727] shadow-2xl transition-opacity duration-300 hover:opacity-100 opacity-90">
    <button id="btn-prev" class="p-2 rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white" title="Slide Anterior (← ou Backspace)">
      <i data-lucide="chevron-left" class="w-5 h-5"></i>
    </button>
    
    <button id="btn-overview" class="flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-white/10 transition-colors text-xs font-semibold text-white/90 hover:text-white" title="Visão Geral (O)">
      <i data-lucide="grid" class="w-4 h-4"></i>
      <span id="slide-indicator">1 / 20</span>
    </button>

    <button id="btn-next" class="p-2 rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white" title="Próximo Slide (→ ou Espaço)">
      <i data-lucide="chevron-right" class="w-5 h-5"></i>
    </button>

    <div class="h-4 w-px bg-white/20 mx-1"></div>

    <button id="btn-fullscreen" class="p-2 rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white" title="Tela Cheia (F)">
      <i data-lucide="maximize" class="w-4 h-4"></i>
    </button>

    <button id="btn-print" class="p-2 rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white" title="Exportar / Imprimir PDF (Ctrl+P)">
      <i data-lucide="printer" class="w-4 h-4"></i>
    </button>

    <button id="btn-help" class="p-2 rounded-full hover:bg-white/10 transition-colors text-white/80 hover:text-white" title="Atalhos do Teclado (?)">
      <i data-lucide="keyboard" class="w-4 h-4"></i>
    </button>
  </nav>

  <!-- ==========================================
       SLIDE OVERVIEW MODAL (GRID VIEW)
       ========================================== -->
  <div id="overview-modal" class="fixed inset-0 z-50 bg-[#0A0A14]/95 backdrop-blur-md hidden flex-col p-12 overflow-y-auto">
    <div class="flex items-center justify-between mb-8 max-w-7xl mx-auto w-full">
      <div>
        <h2 class="text-3xl font-bold text-white">Visão Geral dos Slides</h2>
        <p class="text-sm text-[#5D5D66] mt-1">Selecione qualquer slide para navegar</p>
      </div>
      <button id="btn-close-overview" class="p-2 rounded-xl bg-white/10 text-white hover:bg-white/20">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <div id="overview-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6 max-w-7xl mx-auto w-full pb-12">
      <!-- Injected by JS -->
    </div>
  </div>

  <!-- ==========================================
       KEYBOARD SHORTCUTS HELP MODAL
       ========================================== -->
  <div id="help-modal" class="fixed inset-0 z-50 bg-[#0A0A14]/80 backdrop-blur-sm hidden items-center justify-center p-6">
    <div class="bg-[#0A0A14] border border-[#272727] rounded-[24px] p-8 max-w-md w-full shadow-2xl">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white flex items-center gap-2">
          <i data-lucide="keyboard" class="w-5 h-5 text-[#350EFF]"></i>
          Atalhos do Teclado
        </h3>
        <button id="btn-close-help" class="text-[#5D5D66] hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Próximo Slide</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">→ / Espaço / Enter</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Slide Anterior</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">← / Backspace</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Primeiro / Último</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">Home / End</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Visão Geral (Grid)</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">O / G</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Tela Cheia</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">F</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#272727]">
          <span class="text-[#5D5D66]">Exportar para PDF</span>
          <span class="font-semibold bg-white/10 px-2 py-1 rounded text-white">Ctrl + P</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================
       PRESENTATION ENGINE SCRIPT
       ========================================== -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Presentation State
    const slides = Array.from(document.querySelectorAll('.slide'));
    const totalSlides = slides.length;
    let currentSlide = 1;

    const viewport = document.getElementById('presentation-viewport');
    const stage = document.getElementById('slide-stage');
    const indicator = document.getElementById('slide-indicator');
    const overviewModal = document.getElementById('overview-modal');
    const helpModal = document.getElementById('help-modal');
    const overviewGrid = document.getElementById('overview-grid');

    // 16:9 Scale-to-Fit Engine
    function resizeStage() {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const targetW = 1920;
      const targetH = 1080;

      const scale = Math.min(vw / targetW, vh / targetH);
      stage.style.transform = `scale(${scale})`;
    }

    window.addEventListener('resize', resizeStage);
    resizeStage();

    // Show slide by index (1-based)
    function goToSlide(index) {
      if (index < 1) index = 1;
      if (index > totalSlides) index = totalSlides;

      slides.forEach((slide, idx) => {
        if (idx + 1 === index) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });

      currentSlide = index;
      indicator.textContent = `${currentSlide} / ${totalSlides}`;
      window.location.hash = `#${currentSlide}`;
    }

    function nextSlide() {
      if (currentSlide < totalSlides) {
        goToSlide(currentSlide + 1);
      }
    }

    function prevSlide() {
      if (currentSlide > 1) {
        goToSlide(currentSlide - 1);
      }
    }

    // Toggle Fullscreen
    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => console.log(err));
      } else {
        document.exitFullscreen();
      }
    }

    // Build Overview Grid
    function populateOverview() {
      overviewGrid.innerHTML = '';
      slides.forEach((slide, idx) => {
        const num = idx + 1;
        const title = slide.getAttribute('data-title') || `Slide ${num}`;
        const isDark = slide.classList.contains('bg-[#0A0A14]') || slide.classList.contains('bg-[#350EFF]');
        const card = document.createElement('div');
        card.className = `p-4 rounded-[16px] cursor-pointer transition-all duration-200 border text-left flex flex-col justify-between h-36 ${
          num === currentSlide 
            ? 'bg-[#350EFF] text-white border-white shadow-lg ring-2 ring-[#350EFF]' 
            : 'bg-[#181824] text-[#E6E6EC] border-[#272727] hover:border-[#350EFF] hover:bg-[#202030]'
        }`;
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold">${String(num).padStart(2, '0')}</span>
            <span class="text-[10px] uppercase font-semibold px-1.5 py-0.5 rounded bg-white/10">${isDark ? 'DECK' : 'CONTENT'}</span>
          </div>
          <div class="font-bold text-sm line-clamp-2">${title}</div>
          <div class="text-[10px] text-white/50">Ir para slide</div>
        `;
        card.addEventListener('click', () => {
          goToSlide(num);
          closeOverview();
        });
        overviewGrid.appendChild(card);
      });
      lucide.createIcons();
    }

    function openOverview() {
      populateOverview();
      overviewModal.classList.remove('hidden');
      overviewModal.classList.add('flex');
    }

    function closeOverview() {
      overviewModal.classList.add('hidden');
      overviewModal.classList.remove('flex');
    }

    function toggleOverview() {
      if (overviewModal.classList.contains('hidden')) {
        openOverview();
      } else {
        closeOverview();
      }
    }

    function toggleHelp() {
      if (helpModal.classList.contains('hidden')) {
        helpModal.classList.remove('hidden');
        helpModal.classList.add('flex');
      } else {
        helpModal.classList.add('hidden');
        helpModal.classList.remove('flex');
      }
    }

    // Event Listeners
    document.getElementById('btn-prev').addEventListener('click', prevSlide);
    document.getElementById('btn-next').addEventListener('click', nextSlide);
    document.getElementById('btn-fullscreen').addEventListener('click', toggleFullscreen);
    document.getElementById('btn-overview').addEventListener('click', toggleOverview);
    document.getElementById('btn-close-overview').addEventListener('click', closeOverview);
    document.getElementById('btn-print').addEventListener('click', () => window.print());
    document.getElementById('btn-help').addEventListener('click', toggleHelp);
    document.getElementById('btn-close-help').addEventListener('click', () => {
      helpModal.classList.add('hidden');
      helpModal.classList.remove('flex');
    });

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeOverview();
        helpModal.classList.add('hidden');
        helpModal.classList.remove('flex');
        return;
      }

      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter' || e.key === 'PageDown') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft' || e.key === 'Backspace' || e.key === 'PageUp') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'Home') {
        e.preventDefault();
        goToSlide(1);
      } else if (e.key === 'End') {
        e.preventDefault();
        goToSlide(totalSlides);
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      } else if (e.key === 'o' || e.key === 'O' || e.key === 'g' || e.key === 'G') {
        toggleOverview();
      } else if (e.key === '?') {
        toggleHelp();
      }
    });

    // Initial Hash Check
    if (window.location.hash) {
      const hashNum = parseInt(window.location.hash.replace('#', ''));
      if (!isNaN(hashNum) && hashNum >= 1 && hashNum <= totalSlides) {
        goToSlide(hashNum);
      }
    }
  </script>
</body>
</html>

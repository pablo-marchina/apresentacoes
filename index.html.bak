<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-[#0A0A14] text-[#272727] antialiased select-none">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A2A: Agentes que colaboram | Inteli Academy</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            brand: {
              DEFAULT: '#350EFF',
              dark: '#2708CC',
              light: '#5A38FF',
            },
            deepBlack: '#0A0A14',
            offWhite: '#F5F5F7',
            graphite: '#272727',
            textGray: '#5D5D66',
            softGray: '#E6E6EC',
            lavender: '#EEEDF8',
            accentYellow: '#FFE57F',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'Menlo', 'monospace'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --slide-w: 1920px;
      --slide-h: 1080px;
      --electric-blue: #350EFF;
      --deep-black: #0A0A14;
      --off-white: #F5F5F7;
      --graphite: #272727;
      --gray: #5D5D66;
      --soft-gray: #E6E6EC;
      --lavender: #EEEDF8;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background-color: var(--deep-black);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    #presentation-viewport {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #slide-stage {
      width: var(--slide-w);
      height: var(--slide-h);
      flex-shrink: 0;
      position: relative;
      transform-origin: center center;
      box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.6);
      background-color: var(--off-white);
    }

    .slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: none;
      opacity: 0;
      transition: opacity 0.2s ease-in-out;
      box-sizing: border-box;
    }

    .slide.active {
      display: flex;
      opacity: 1;
      z-index: 10;
    }

    /* Print styling for direct PDF export */
    @media print {
      body {
        overflow: visible !important;
        background: transparent !important;
      }
      #presentation-viewport {
        position: static !important;
        display: block !important;
      }
      #slide-stage {
        transform: none !important;
        box-shadow: none !important;
        width: 100% !important;
        height: auto !important;
      }
      .slide {
        display: flex !important;
        opacity: 1 !important;
        position: relative !important;
        page-break-after: always !important;
        page-break-inside: avoid !important;
        width: 100vw !important;
        height: 56.25vw !important; /* 16:9 ratio */
        margin-bottom: 0 !important;
      }
      #controls-bar, #overview-modal, #help-modal {
        display: none !important;
      }
      @page {
        size: 16in 9in landscape;
        margin: 0;
      }
    }

    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(93, 93, 102, 0.3);
      border-radius: 9999px;
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden bg-[#0A0A14] text-[#272727]">

  <!-- Main Viewport that scales the 1920x1080 slide stage to fit browser window -->
  <main id="presentation-viewport">
    <div id="slide-stage" class="rounded-none overflow-hidden">

      <!-- ==========================================
           SLIDE 1: CAPA (Electric Blue Background)
           ========================================== -->
      <section class="slide active flex-col justify-between p-24 bg-[#350EFF] text-white relative overflow-hidden" data-slide="1" data-title="Capa">
        <!-- Abstract geometric line vectors -->
        <svg class="absolute right-0 top-0 w-[950px] h-full pointer-events-none opacity-20" viewBox="0 0 950 1080" fill="none">
          <polygon points="120,0 950,0 950,600 350,1080 0,720" stroke="#EEEDF8" stroke-width="2" />
          <line x1="280" y1="0" x2="850" y2="1080" stroke="#EEEDF8" stroke-width="1.5" stroke-dasharray="8 8" />
          <polygon points="400,150 900,100 820,850 250,550" stroke="#FFFFFF" stroke-width="1.5" />
          <circle cx="680" cy="420" r="280" stroke="#EEEDF8" stroke-width="1.5" />
        </svg>

        <!-- Top metadata -->
        <div class="relative z-10">
          <div class="text-2xl font-semibold tracking-tight text-white mb-2">Inteli Academy</div>
          <div class="text-sm font-semibold tracking-[0.2em] text-[#EEEDF8] uppercase">FUNDAMENTOS DE IA APLICADA</div>
        </div>

        <!-- Center Main Title -->
        <div class="relative z-10 my-auto max-w-5xl">
          <h1 class="text-[112px] font-black tracking-tight text-white leading-none mb-6">
            A2A
          </h1>
          <h2 class="text-5xl font-bold tracking-tight text-white mb-6">
            Agentes que colaboram
          </h2>
          <p class="text-2xl text-[#EEEDF8] font-normal leading-relaxed max-w-3xl">
            Como agentes descobrem capacidades, delegam tarefas e trocam resultados sem expor sua complexidade interna.
          </p>
        </div>

        <!-- Footer -->
        <div class="relative z-10 flex items-center justify-between pt-8 border-t border-white/20 text-[#EEEDF8]/80 text-sm">
          <div class="font-medium tracking-wide">Protocolo de Interoperabilidade Multi-Agente</div>
          <span class="text-white font-semibold">01</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 2: AGENDA / VISÃO GERAL (Editorial Vertical List)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="2" data-title="Visão Geral">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">ESTRUTURA DA AULA</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Do problema à colaboração entre agentes</h2>
        </div>

        <!-- Editorial 5-row list -->
        <div class="my-auto divide-y divide-[#E6E6EC] border-y border-[#E6E6EC]">
          <!-- Row 1 -->
          <div class="flex items-center justify-between py-6">
            <div class="flex items-center gap-10">
              <span class="text-3xl font-extrabold text-[#350EFF] w-12">01</span>
              <span class="text-2xl font-bold text-[#272727]">O que é um agente?</span>
            </div>
            <span class="text-sm font-semibold tracking-[0.15em] text-[#5D5D66] uppercase">AGENTE VS. CHATBOT</span>
          </div>

          <!-- Row 2 -->
          <div class="flex items-center justify-between py-6">
            <div class="flex items-center gap-10">
              <span class="text-3xl font-extrabold text-[#350EFF] w-12">02</span>
              <span class="text-2xl font-bold text-[#272727]">Quando um agente precisa de outro?</span>
            </div>
            <span class="text-sm font-semibold tracking-[0.15em] text-[#5D5D66] uppercase">SISTEMAS MULTI-AGENTE</span>
          </div>

          <!-- Row 3 -->
          <div class="flex items-center justify-between py-6">
            <div class="flex items-center gap-10">
              <span class="text-3xl font-extrabold text-[#350EFF] w-12">03</span>
              <span class="text-2xl font-bold text-[#272727]">A2A: O padrão aberto</span>
            </div>
            <span class="text-sm font-semibold tracking-[0.15em] text-[#350EFF] uppercase">INTEROPERABILIDADE</span>
          </div>

          <!-- Row 4 -->
          <div class="flex items-center justify-between py-6">
            <div class="flex items-center gap-10">
              <span class="text-3xl font-extrabold text-[#350EFF] w-12">04</span>
              <span class="text-2xl font-bold text-[#272727]">Como a conversa acontece?</span>
            </div>
            <span class="text-sm font-semibold tracking-[0.15em] text-[#5D5D66] uppercase">TASKS • MESSAGES • ARTIFACTS</span>
          </div>

          <!-- Row 5 -->
          <div class="flex items-center justify-between py-6">
            <div class="flex items-center gap-10">
              <span class="text-3xl font-extrabold text-[#350EFF] w-12">05</span>
              <span class="text-2xl font-bold text-[#272727]">A2A × MCP</span>
            </div>
            <span class="text-sm font-semibold tracking-[0.15em] text-[#5D5D66] uppercase">AGENTE ↔ AGENTE / AGENTE ↔ FERRAMENTA</span>
          </div>
        </div>

        <div class="flex justify-between items-center text-sm text-[#5D5D66]">
          <span>A2A Protocol</span>
          <span class="font-semibold">02</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 3: DIVISOR 1
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#0A0A14] text-white relative overflow-hidden" data-slide="3" data-title="Seção 1">
        <div class="text-sm font-semibold tracking-[0.2em] text-[#350EFF] uppercase">PARTE 01</div>

        <div class="my-auto max-w-4xl">
          <div class="text-[140px] font-black text-[#350EFF] leading-none mb-4">1</div>
          <h2 class="text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">O que é um agente?</h2>
          <p class="text-2xl text-[#5D5D66] font-medium tracking-wide uppercase">
            ANTES DO A2A, PRECISAMOS DEFINIR O QUE ESTÁ SE COMUNICANDO
          </p>
        </div>

        <div class="flex justify-between items-center text-sm text-[#5D5D66]">
          <span class="font-semibold uppercase tracking-wider">FUNDAMENTOS</span>
          <span class="font-semibold">03</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 4: PONTO DE PARTIDA (Ciclo do Agente)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="4" data-title="Ponto de Partida">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">PONTO DE PARTIDA</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Um agente recebe um objetivo e age sobre o ambiente</h2>
        </div>

        <!-- 3 Step Cards -->
        <div class="grid grid-cols-3 gap-8 my-auto">
          <!-- Step 1 -->
          <div class="bg-white rounded-[24px] p-9 border border-[#E6E6EC] flex flex-col justify-between h-72">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-3">01 • ENTRADA</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-2">Objetivo</h3>
              <p class="text-[#5D5D66] text-lg leading-relaxed">+ Contexto e restrições fornecidas pelo usuário.</p>
            </div>
            <div class="text-sm font-semibold text-[#5D5D66]">Meta inicial</div>
          </div>

          <!-- Step 2 -->
          <div class="bg-white rounded-[24px] p-9 border border-[#E6E6EC] flex flex-col justify-between h-72">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-3">02 • DECISÃO</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-2">Planeja</h3>
              <p class="text-[#5D5D66] text-lg leading-relaxed">+ Raciocina e escolhe os próximos passos.</p>
            </div>
            <div class="text-sm font-semibold text-[#5D5D66]">Deliberação</div>
          </div>

          <!-- Step 3 -->
          <div class="bg-white rounded-[24px] p-9 border border-[#E6E6EC] flex flex-col justify-between h-72">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-3">03 • AÇÃO</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-2">Ferramentas</h3>
              <p class="text-[#5D5D66] text-lg leading-relaxed">+ Executa chamadas e altera o estado do sistema.</p>
            </div>
            <div class="text-sm font-semibold text-[#5D5D66]">Execução</div>
          </div>
        </div>

        <!-- Faixa de Destaque -->
        <div class="bg-[#EEEDF8] rounded-2xl px-8 py-5 flex items-center justify-between text-[#272727]">
          <div class="flex items-center gap-6">
            <span class="text-sm font-bold uppercase tracking-[0.15em] text-[#350EFF] shrink-0">OBSERVAÇÃO</span>
            <span class="text-lg text-[#272727]">Analisa o retorno → ajusta o plano → tenta novamente → conclui a tarefa</span>
          </div>
          <span class="text-sm font-bold text-[#350EFF] uppercase tracking-wider">Ciclo Fechado</span>
        </div>

        <!-- Bottom Takeaway -->
        <div class="flex justify-between items-center text-base text-[#5D5D66] pt-2">
          <span><strong>Agente ≠ apenas texto gerado.</strong> O diferencial é a capacidade de decidir e executar ações orientadas a um objetivo.</span>
          <span class="font-semibold">04</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 5: A DISTINÇÃO (Chatbot vs Agente)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="5" data-title="A Distinção">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">A DISTINÇÃO</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Chatbot responde. Agente persegue um objetivo.</h2>
        </div>

        <!-- 2 Comparison Columns -->
        <div class="grid grid-cols-2 gap-10 my-auto">
          <!-- Chatbot -->
          <div class="bg-white rounded-[24px] p-10 border border-[#E6E6EC] flex flex-col justify-between h-80">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#5D5D66] mb-4">REATIVO</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-6">CHATBOT</h3>
              <ul class="space-y-4 text-lg text-[#5D5D66]">
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#5D5D66]"></span> Reage à mensagem do usuário</li>
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#5D5D66]"></span> Gera uma resposta em turno único</li>
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-[#5D5D66]"></span> Fluxo curto e baixa autonomia</li>
              </ul>
            </div>
            <div class="text-sm font-semibold text-[#5D5D66]">Foco: Diálogo</div>
          </div>

          <!-- Agente -->
          <div class="bg-white rounded-[24px] p-10 border-2 border-[#350EFF] flex flex-col justify-between h-80">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-4">AUTÔNOMO</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-6">AGENTE</h3>
              <ul class="space-y-4 text-lg text-[#272727] font-medium">
                <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-[#350EFF]"></span> Interpreta um objetivo de alto nível</li>
                <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-[#350EFF]"></span> Planeja e decompõe etapas necessárias</li>
                <li class="flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-[#350EFF]"></span> Usa ferramentas e pode <strong>delegar</strong> tarefas</li>
              </ul>
            </div>
            <div class="text-sm font-bold text-[#350EFF]">Foco: Resolução de Tarefas</div>
          </div>
        </div>

        <!-- Faixa de Destaque -->
        <div class="bg-[#EEEDF8] rounded-2xl px-8 py-5 flex items-center justify-between text-[#272727]">
          <div class="flex items-center gap-6">
            <span class="text-sm font-bold uppercase tracking-[0.15em] text-[#350EFF] shrink-0">PERGUNTA-CHAVE</span>
            <span class="text-xl font-bold text-[#272727]">“Quem decide qual é o próximo passo da execução?”</span>
          </div>
          <span class="font-semibold text-sm text-[#5D5D66]">05</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 6: DIVISOR 2
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#0A0A14] text-white relative overflow-hidden" data-slide="6" data-title="Seção 2">
        <div class="text-sm font-semibold tracking-[0.2em] text-[#350EFF] uppercase">PARTE 02</div>

        <div class="my-auto max-w-4xl">
          <div class="text-[140px] font-black text-[#350EFF] leading-none mb-4">2</div>
          <h2 class="text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">Quando um agente precisa de outro?</h2>
          <p class="text-2xl text-[#5D5D66] font-medium tracking-wide uppercase">
            O PROBLEMA APARECE QUANDO UMA TAREFA COMBINA ESPECIALISTAS DIFERENTES
          </p>
        </div>

        <div class="flex justify-between items-center text-sm text-[#5D5D66]">
          <span class="font-semibold uppercase tracking-wider">ESPECIALIZAÇÃO</span>
          <span class="font-semibold">06</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 7: SISTEMA MULTI-AGENTE
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="7" data-title="Sistema Multi-Agente">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">SISTEMA MULTI-AGENTE</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Dividir para especializar</h2>
          <p class="text-[#5D5D66] text-xl mt-2">Um agente pode coordenar um trabalho maior sem executar todas as capacidades sozinho.</p>
        </div>

        <!-- Orchestrator & Specialist Flow -->
        <div class="my-auto flex flex-col items-center w-full max-w-5xl mx-auto">
          <!-- Orchestrator Box -->
          <div class="bg-[#350EFF] text-white px-10 py-5 rounded-2xl shadow-sm text-center w-84">
            <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#EEEDF8] mb-1.5">COORDENADOR</div>
            <h3 class="text-2xl font-bold">AGENTE ORQUESTRADOR</h3>
          </div>

          <!-- Architectural SVG Branching Tree Connector -->
          <div class="w-full h-16 my-1">
            <svg class="w-full h-full" viewBox="0 0 1024 64" fill="none">
              <!-- Central trunk coming down from Orchestrator -->
              <path d="M 512,0 L 512,28" stroke="#350EFF" stroke-width="2" stroke-linecap="round" />
              
              <!-- Left branch to Specialist 1 -->
              <path d="M 512,28 L 160,28 L 160,52" stroke="#350EFF" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              <polygon points="154,50 160,60 166,50" fill="#350EFF" />
              
              <!-- Center branch to Specialist 2 -->
              <path d="M 512,28 L 512,52" stroke="#350EFF" stroke-width="2" stroke-linecap="round" />
              <polygon points="506,50 512,60 518,50" fill="#350EFF" />
              
              <!-- Right branch to Specialist 3 -->
              <path d="M 512,28 L 864,28 L 864,52" stroke="#350EFF" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
              <polygon points="858,50 864,60 870,50" fill="#350EFF" />
            </svg>
          </div>

          <!-- 3 Specialists -->
          <div class="grid grid-cols-3 gap-8 w-full">
            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-2">ESPECIALISTA 01</div>
              <h4 class="text-2xl font-bold text-[#272727]">Pesquisa</h4>
              <p class="text-[#5D5D66] text-base mt-2">Busca, extração e síntese</p>
            </div>

            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-2">ESPECIALISTA 02</div>
              <h4 class="text-2xl font-bold text-[#272727]">Finanças</h4>
              <p class="text-[#5D5D66] text-base mt-2">Cálculo e validação de regras</p>
            </div>

            <div class="bg-white p-8 rounded-[24px] border border-[#E6E6EC] text-center">
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-2">ESPECIALISTA 03</div>
              <h4 class="text-2xl font-bold text-[#272727]">Domínio</h4>
              <p class="text-[#5D5D66] text-base mt-2">Regras de negócio específicas</p>
            </div>
          </div>
        </div>

        <!-- Faixa Lavender -->
        <div class="bg-[#EEEDF8] rounded-2xl px-8 py-5 flex items-center justify-between text-[#272727]">
          <div class="flex items-center gap-6">
            <span class="text-sm font-bold uppercase tracking-[0.15em] text-[#350EFF] shrink-0">PERGUNTA FUNDAMENTAL</span>
            <span class="text-lg font-medium text-[#272727]">Como esses agentes se encontram, negociam e se entendem?</span>
          </div>
          <span class="font-semibold text-sm text-[#5D5D66]">07</span>
        </div>
      </section>

      <!-- ==========================================
           SLIDE 8: O GARGALO (Sem Padrão)
           ========================================== -->
      <section class="slide flex-col justify-between p-24 bg-[#F5F5F7] text-[#272727] relative" data-slide="8" data-title="O Gargalo">
        <!-- Header -->
        <div>
          <span class="text-base font-semibold uppercase tracking-[0.15em] text-[#350EFF]">O GARGALO</span>
          <h2 class="text-5xl font-extrabold text-[#272727] tracking-tight mt-2">Sem um padrão, a colaboração vira integração artesanal</h2>
        </div>

        <!-- 3 Core Bottleneck Cards -->
        <div class="my-auto grid grid-cols-3 gap-8 w-full">
          
          <div class="bg-white p-9 rounded-[24px] border border-[#E6E6EC] shadow-sm flex flex-col justify-between h-72">
            <div>

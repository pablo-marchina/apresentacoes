          <!-- MCP -->
          <div class="bg-white p-9 rounded-[24px] border border-[#E6E6EC] flex flex-col justify-between h-80">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#5D5D66] mb-2">MODEL CONTEXT PROTOCOL</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-2">MCP</h3>
              <div class="text-base font-semibold text-[#350EFF] mb-3 uppercase">AGENTE ↔ FERRAMENTA / CONTEXTO</div>
              <p class="text-[#5D5D66] text-base mb-2">Ex.: banco, API, arquivo, sistema interno.</p>
              <p class="text-[#272727] text-base font-medium"><strong>Foco:</strong> fornecer capacidades e contexto ao agente.</p>
            </div>
            <div class="text-xs font-semibold text-[#5D5D66]">Conexão com Recursos</div>
          </div>

          <!-- A2A (Destacado com Borda #350EFF) -->
          <div class="bg-white p-9 rounded-[24px] border-2 border-[#350EFF] flex flex-col justify-between h-80">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#350EFF] mb-2">AGENT TO AGENT PROTOCOL</div>
              <h3 class="text-3xl font-bold text-[#272727] mb-2">A2A</h3>
              <div class="text-base font-semibold text-[#350EFF] mb-3 uppercase">AGENTE ↔ AGENTE</div>
              <p class="text-[#5D5D66] text-base mb-2">Ex.: agente financeiro, agente de viagens.</p>
              <p class="text-[#272727] text-base font-medium"><strong>Foco:</strong> descoberta, delegação e colaboração autônoma.</p>
            </div>
            <div class="text-xs font-bold text-[#350EFF]">Conexão entre Pares</div>
          </div>
        </div>

        <!-- Faixa Lavender -->
        <div class="bg-[#EEEDF8] rounded-2xl px-8 py-5 flex items-center justify-between text-[#272727]">
